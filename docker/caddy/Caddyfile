{
    # Global options
    # email your-email@example.com # Uncomment for Let's Encrypt notifications
}

:80 {
    encode gzip

    # Proxy API requests to backend
    handle /api/* {
        reverse_proxy backend:8000
    }

    # Serve frontend static files
    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }
}
